# Copy to .env at the repo root. docker compose reads it automatically.
# .env is gitignored — never commit a key.

# Required for real pack generation. One shared key for the team is fine today.
ANTHROPIC_API_KEY=

# Do not downgrade this. The teacher cannot verify what we generate, so output
# quality is a safety property, not a preference. Use the pack cache to save money.
ELIMU_MODEL=claude-opus-5

# true = generators return the sample fixture instead of calling the API.
# Turn this on while building UI so nobody burns credits on hot reloads.
ELIMU_USE_FIXTURES=false

DATABASE_URL=postgres://elimu:elimu@localhost:5432/elimu
CORS_ORIGIN=http://localhost:5173
PORT=4000
