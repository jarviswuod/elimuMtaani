# elimuMtaani — web app environment template
# Copy to .env (or .env.local) and fill in the values. Never commit real keys.
#   cp .env.example .env

# ── Clerk (auth) ──────────────────────────────────────────────────────────────
# Get keys from https://dashboard.clerk.com → your app → API Keys.
# (Dev bootstrap: `npx clerk@latest init` can mint temporary accountless keys.)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk route config (defaults match the scaffolded pages)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ── Convex (database + backend actions) ──────────────────────────────────────
# Written automatically by `npx convex dev` after login; shown here for reference.
CONVEX_DEPLOYMENT=dev:your-deployment-123
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-123.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-123.convex.site

# NOTE: server-side secrets used inside Convex actions do NOT go in this file —
# set them on the deployment instead:
#   npx convex env set ANTHROPIC_API_KEY sk-ant-...
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
#   npx convex env set ELIMU_USE_FIXTURES true|false   # demo insurance (DEC-010)

# ── App flags (Next.js side) ──────────────────────────────────────────────────
# Fixtures mode for UI development without burning API credits (DEC-010)
ELIMU_USE_FIXTURES=false
